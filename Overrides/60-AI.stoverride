name: OpenAI / Claude 精准分流
desc: 将 OpenAI、ChatGPT、Claude 及相关 API 流量转发至「🤖 AI 服務」。
author: HJ
category: HJ Stash
rule-providers:
  hj-60-ai-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.openai.com
    - +.chatgpt.com
    - +.oaistatic.com
    - +.oaiusercontent.com
    - +.oaistatsig.com
    - +.sora.com
    - events.statsigapi.net
    - +.anthropic.com
    - +.claude.ai
    - +.claude.com
    - +.claudeusercontent.com
    - +.claudemcpcontent.com
rules:
- RULE-SET,hj-60-ai-domain-1,🤖 AI 服務
