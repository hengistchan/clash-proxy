name: Google AI 精准分流
desc: 将 Gemini、AI Studio、NotebookLM 和 Google AI API 流量转发至「🤖 AI 服務」。
author: HJ
category: HJ Stash
rule-providers:
  hj-61-googleai-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.gemini.google.com
    - +.gemini.google
    - +.aistudio.google.com
    - +.ai.google.dev
    - +.generativelanguage.googleapis.com
    - +.aiplatform.googleapis.com
    - +.notebooklm.google.com
    - +.notebooklm.google
    - +.flow.google
    - +.jules.google
rules:
- RULE-SET,hj-61-googleai-domain-1,🤖 AI 服務
