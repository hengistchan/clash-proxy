name: YouTube 媒体分流
desc: 将 YouTube 及视频 CDN 流量转发至「🌐 通用代理」。
author: HJ
category: HJ Stash
rule-providers:
  hj-30-media-youtube-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.youtube.com
    - +.ytimg.com
    - +.googlevideo.com
rules:
- RULE-SET,hj-30-media-youtube-domain-1,🌐 通用代理
