name: Telegram / X 完整规则
desc: 'RC4 parity-first; source: v1.3; do not reorder.'
author: HJ
rule-providers:
  hj-50-social-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.telegram.org
    - +.telegram.me
    - +.telegram-cdn.org
    - +.t.me
    - +.telegra.ph
  hj-50-social-ipcidr-2:
    type: inline
    behavior: ipcidr
    payload:
    - 149.154.160.0/20
    - 5.28.192.0/18
    - 91.108.0.0/16
    - 2001:67c:4e8::/48
    - 2001:b28:f23c::/47
  hj-50-social-domain-3:
    type: inline
    behavior: domain
    payload:
    - +.x.com
    - +.twitter.com
    - +.twimg.com
    - +.t.co
    - +.twttr.com
  Repcz-Telegram:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Telegram.list
    path: ./rules/hj-telegram.list
    interval: 86400
  Repcz-Twitter:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Twitter.list
    path: ./rules/hj-twitter.list
    interval: 86400
rules:
- PROTOCOL,MTPROTO,🇹🇼 台灣・故障備援
- RULE-SET,hj-50-social-domain-1,🇹🇼 台灣・故障備援
- RULE-SET,hj-50-social-ipcidr-2,🇹🇼 台灣・故障備援,no-resolve
- RULE-SET,Repcz-Telegram,🇹🇼 台灣・故障備援
- RULE-SET,hj-50-social-domain-3,🇹🇼 台灣・故障備援
- RULE-SET,Repcz-Twitter,🇹🇼 台灣・故障備援
