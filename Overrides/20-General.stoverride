name: Google / Microsoft / Apple 常规服务
desc: Google 服务走通用代理；Microsoft、Apple 与常用 iCloud、App Store 服务保持直连。
author: HJ
category: HJ Stash
rule-providers:
  hj-20-general-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.google.com
    - +.gstatic.com
    - +.googleapis.com
  hj-20-general-domain-2:
    type: inline
    behavior: domain
    payload:
    - +.microsoft.com
    - +.microsoftonline.com
    - +.office.com
    - +.office365.com
    - +.live.com
    - +.windows.net
    - +.azure.com
    - +.apple.com.cn
    - +.icloud.com
    - +.apple.com
    - +.cdn-apple.com
    - +.itunes.com
    - +.appstore.com
    - +.mzstatic.com
  hj-20-general-exclusions:
    type: inline
    behavior: domain
    payload:
    - +.lan
    - +.local
    - +.home.arpa
    - +.push.apple.com
    - +.akadns.net
    - +.apple.com.edgekey.net
    - guzzoni.apple.com
    - +.smoot.apple.com
    - apple-relay.apple.com
    - apple-relay.cloudflare.com
    - apple-relay.fastly-edge.com
    - cp4.cloudflare.com
    - +.servicewechat.com
    - +.wxs.qq.com
    - +.weixin.qq.com
    - +.wx.qq.com
    - +.wx.gtimg.com
    - +.wxamedia.com
    - +.weixin.com
    - +.wechat.com
    - +.wechatpay.com
    - +.tenpay.com
    - +.qpic.cn
    - +.qlogo.cn
    - +.qq.com
    - +.gtimg.com
    - +.tencent-cloud.net
    - +.feishu.cn
    - +.feishu.net
    - +.feishucdn.com
    - +.feishuimg.com
    - +.feishuapp.cn
    - +.feishupkg.com
    - +.larkoffice.com
    - +.bytedance.com
    - +.bytedance.net
    - +.byteimg.com
    - +.bytescm.com
    - +.bytetos.com
    - +.snssdk.com
    - +.pstatp.com
    - +.zijieapi.com
    - +.bdurl.net
    - +.ctobsnssdk.com
    - +.toutiaocloud.com
    - +.meituan.com
    - +.meituan.net
    - +.meituanimg.com
    - +.meituanstatic.com
    - +.dianping.com
    - +.dpfile.com
    - +.sankuai.com
    - +.sankuai.cn
    - +.telegram.org
    - +.telegram.me
    - +.telegram-cdn.org
    - +.t.me
    - +.telegra.ph
    - +.x.com
    - +.twitter.com
    - +.twimg.com
    - +.t.co
    - +.twttr.com
    - +.openai.com
    - +.chatgpt.com
    - +.oaistatic.com
    - +.oaiusercontent.com
    - +.oaistatsig.com
    - +.sora.com
    - events.statsigapi.net
    - +.anthropic.com
    - +.claude.ai
    - +.claude.com
    - +.claudeusercontent.com
    - +.claudemcpcontent.com
    - +.github-releases.githubusercontent.com
    - +.github.com
    - +.githubusercontent.com
    - +.githubassets.com
    - +.github.io
    - +.github.dev
    - +.githubapp.com
    - +.youtube.com
    - +.ytimg.com
    - +.googlevideo.com
    - +.gemini.google.com
    - +.gemini.google
    - +.aistudio.google.com
    - +.ai.google.dev
    - +.generativelanguage.googleapis.com
    - +.aiplatform.googleapis.com
    - +.notebooklm.google.com
    - +.notebooklm.google
    - +.flow.google
    - +.jules.google
    - +.larksuite.com
    - +.netflix.com
    - +.nflxvideo.net
    - +.disneyplus.com
    - +.spotify.com
    - +.huggingface.co
    - +.hf.co
    - +.steamcontent.com
  Repcz-Google:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Google.list
    path: ./rules/hj-google.list
    interval: 86400
  hj-20-ads-filter:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Ads_AWAvenue.list
    path: ./rules/hj-20-ads-filter.list
    interval: 86400
  hj-20-telegram-exclusion:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Telegram.list
    path: ./rules/hj-20-telegram-exclusion.list
    interval: 86400
  hj-20-twitter-exclusion:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Twitter.list
    path: ./rules/hj-20-twitter-exclusion.list
    interval: 86400
rules:
- AND,((RULE-SET,hj-20-general-domain-1),(NOT,((RULE-SET,hj-20-general-exclusions))),(NOT,((RULE-SET,hj-20-ads-filter))),(NOT,((RULE-SET,hj-20-telegram-exclusion))),(NOT,((RULE-SET,hj-20-twitter-exclusion))),(NOT,((DOMAIN-KEYWORD,apple.com.edgekey.net)))),🌐 通用代理
- AND,((RULE-SET,Repcz-Google),(NOT,((RULE-SET,hj-20-general-exclusions))),(NOT,((RULE-SET,hj-20-ads-filter))),(NOT,((RULE-SET,hj-20-telegram-exclusion))),(NOT,((RULE-SET,hj-20-twitter-exclusion))),(NOT,((DOMAIN-KEYWORD,apple.com.edgekey.net)))),🌐 通用代理
- AND,((RULE-SET,hj-20-general-domain-2),(NOT,((RULE-SET,hj-20-general-exclusions))),(NOT,((RULE-SET,hj-20-ads-filter))),(NOT,((RULE-SET,hj-20-telegram-exclusion))),(NOT,((RULE-SET,hj-20-twitter-exclusion))),(NOT,((DOMAIN-KEYWORD,apple.com.edgekey.net)))),DIRECT
