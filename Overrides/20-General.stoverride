name: Google / Microsoft / Apple 常规服务
desc: Google 服务走通用代理；Microsoft、Apple 与常用 iCloud、App Store 服务保持直连。
author: HJ
category: HJ Stash
rule-providers:
  hj-20-general-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.google.com
    - +.gstatic.com
    - +.googleapis.com
  hj-20-general-domain-2:
    type: inline
    behavior: domain
    payload:
    - +.microsoft.com
    - +.microsoftonline.com
    - +.office.com
    - +.office365.com
    - +.live.com
    - +.windows.net
    - +.azure.com
    - +.apple.com.cn
    - +.icloud.com
    - +.apple.com
    - +.cdn-apple.com
    - +.itunes.com
    - +.appstore.com
    - +.mzstatic.com
  Repcz-Google:
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Repcz/Tool/X/Stash/Rules/Google.list
    path: ./rules/hj-google.list
    interval: 86400
rules:
- RULE-SET,hj-20-general-domain-1,🌐 通用代理
- RULE-SET,Repcz-Google,🌐 通用代理
- RULE-SET,hj-20-general-domain-2,DIRECT
