name: 流媒体和下载
desc: 'RC4 parity-first; source: v1.3; do not reorder.'
author: HJ
rule-providers:
  hj-31-media-streaming-domain-1:
    type: inline
    behavior: domain
    payload:
    - +.larksuite.com
    - +.netflix.com
    - +.nflxvideo.net
    - +.disneyplus.com
    - +.spotify.com
  hj-31-media-streaming-domain-2:
    type: inline
    behavior: domain
    payload:
    - +.huggingface.co
    - +.hf.co
    - +.steamcontent.com
rules:
- RULE-SET,hj-31-media-streaming-domain-1,🌐 通用代理
- RULE-SET,hj-31-media-streaming-domain-2,⚡ 自動選優
